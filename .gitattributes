# Setup scripts must keep their platform's line endings: a CRLF in a shell
# script breaks the shebang on Linux and MacOS.
*.sh  text eol=lf
*.ps1 text eol=crlf

# lazy.nvim always writes this file with LF (it opens it "wb"), so pin the
# working copy to LF too. core.autocrlf is true on Windows, so without this a
# fresh clone gets CRLF and the first bootstrap looks like a lockfile change.
lazy-lock.json text eol=lf
